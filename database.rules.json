{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "auth != null && (!data.exists() || data.child('hostUid').val() === auth.uid)",
        ".write": "auth != null && $code.matches(/^[A-Z]{4}$/) && ((!data.exists() && newData.child('hostUid').val() === auth.uid) || data.child('hostUid').val() === auth.uid)",
        "hostUid": {
          ".validate": "newData.isString() && ((!data.exists() && newData.val() === auth.uid) || newData.val() === data.val())"
        },
        "checkpoint": {
          ".validate": "newData.isString()"
        },
        "public": {
          ".read": "auth != null",
          ".validate": "newData.isString()"
        },
        "lease": {
          ".read": "auth != null"
        },
        "presence": {
          ".read": "auth != null"
        },
        "views": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".validate": "newData.isString()"
          }
        },
        "receipts": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid"
          }
        },
        "actions": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            "$id": {
              ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('hostUid').exists() && !data.exists() && newData.exists()",
              ".validate": "newData.hasChildren(['id', 'actorUid', 'revision', 'type', 'payload'])",
              "id": {
                ".validate": "newData.isString() && newData.val() === $id && newData.val().length <= 64"
              },
              "actorUid": {
                ".validate": "newData.val() === $uid"
              },
              "revision": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              },
              "type": {
                ".validate": "newData.isString() && newData.val().length <= 32"
              },
              "payload": {
                ".validate": "newData.isString() && newData.val().length <= 12000"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        }
      }
    }
  }
}
